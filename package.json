  "scripts": {
    "dev": "concurrently -n web,api -c green,cyan \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "build": "npm run build --workspace=apps/web && npm run build --workspace=apps/api",
    "start": "concurrently -n web,api -c green,cyan \"npm run preview --workspace=apps/web\" \"npm run start:prod --workspace=apps/api\"",
    "install:all": "npm install && npm install --workspace=apps/web && npm install --workspace=apps/api"
  },
