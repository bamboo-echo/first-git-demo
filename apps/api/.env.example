# 服务配置
PORT=4000
NODE_ENV=development

# 数据库（默认 SQLite 便于本地运行；生产用 PostgreSQL）
DATABASE_URL="file:./storage/dev.db"

# JWT 密钥（生产环境务必修改）
JWT_SECRET="kaodian-radar-trae-2026-secret-key-change-in-prod"
JWT_EXPIRES_IN="7d"

# CORS（前端地址）
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,https://kaodian-radar.vercel.app"

# AI 模式：local / openai / deepseek
AI_PROVIDER="local"
AI_API_KEY=""
AI_BASE_URL=""

# 文件上传
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=20971520
