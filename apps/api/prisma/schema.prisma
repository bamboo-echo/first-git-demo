// 考点雷达数据库设计
// 支持 SQLite（本地一键运行）和 PostgreSQL（生产部署）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // 部署到生产时改为 "postgresql" 并提供对应 DATABASE_URL
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  username               String
  password               String
  role                   String    @default("user")
  passwordResetToken     String?
  passwordResetExpiresAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  courses   Course[]
  history   HistoryRecord[]
}

model Course {
  id           String   @id @default(cuid())
  userId       String
  name         String
  examTime     String   @default("")
  reviewHours  String   @default("8")
  goalMode     String   @default("冲刺")
  examScope    String   @default("")
  notes        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  materials Material[]
  tasks     Task[]
  analyses  Analysis[]
  plans     Plan[]

  @@index([userId])
}

model Material {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String   @default("")
  format      String   @default("PDF")
  category    String   @default("exam")
  status      String   @default("draft")
  fileName    String?
  fileUrl     String?
  uploadedAt  DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Task {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  detail    String   @default("")
  duration  String   @default("30分钟")
  done      Boolean  @default(false)
  priority  String   @default("medium")
  mode      String   @default("standard")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Analysis {
  id              String   @id @default(cuid())
  courseId        String
  questionTypes   String   @default("[]") // JSON
  keyPoints       String   @default("[]") // JSON
  evidence        String   @default("[]") // JSON
  readinessScore  Int      @default(0)
  supplementList  String   @default("[]") // JSON
  summary         String   @default("[]") // JSON
  aiProvider      String   @default("local")
  generatedAt     DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Plan {
  id          String   @id @default(cuid())
  courseId    String
  mode        String
  title       String
  description String   @default("")
  items       String   @default("[]") // JSON
  generatedAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model HistoryRecord {
  id              String   @id @default(cuid())
  userId          String
  courseId        String
  courseName      String
  finalScore      Int?
  keyPointsCount  Int      @default(0)
  tasksTotal      Int      @default(0)
  tasksDone       Int      @default(0)
  snapshotSummary String   @default("[]")
  archivedAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
